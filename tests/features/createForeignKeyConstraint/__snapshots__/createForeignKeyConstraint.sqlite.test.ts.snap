create index \`author_following_author_2_id_index\` on \`author_following\` (\`author_2_id\`);

create table \`author_address\` (\`author_id\` integer not null primary key, \`value\` text not null, constraint \`author_address_author_id_foreign\` foreign key (\`author_id\`) references \`author\` (\`id\`) on update cascade on delete cascade);

