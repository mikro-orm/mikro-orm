create table \`author_following\` (\`author_1_id\` integer not null, \`author_2_id\` integer not null, primary key (\`author_1_id\`, \`author_2_id\`), constraint \`author_following_author_1_id_foreign\` foreign key (\`author_1_id\`) references \`author\` (\`id\`) on update cascade on delete cascade, constraint \`author_following_author_2_id_foreign\` foreign key (\`author_2_id\`) references \`author\` (\`id\`) on update cascade on delete cascade);
