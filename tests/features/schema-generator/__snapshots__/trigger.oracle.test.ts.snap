// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`trigger [oracle] > create DDL and the trigger fires [oracle] 1`] = `
"create table "trigger_entity" ("id" number(10, 0) generated by default as identity not null primary key, "price" number(10, 0) not null, "price_with_tax" number(10, 0) null);
create or replace trigger "trg_price_tax" BEFORE INSERT OR UPDATE on "trigger_entity" for each row begin :new."price_with_tax" := :new."price" * 1.2; end;
"
`;
